/* ---------------------------------------------------------
   PDF DÖNÜŞTÜR / PDF DÜZENLE ortak bileşenleri
   --------------------------------------------------------- */

#opDropZone {
    background-color: #F8FAFD;

    border: 2px dashed #C9D8EE;
    border-radius: 16px;
}

#opDropZoneTitle {
    background: transparent;

    color: #172033;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 17px;
}

#opDropZoneHint {
    background: transparent;

    color: #6B7A90;

    font-size: 13px;
}

#opPrimaryButton {
    background-color: #2563EB;

    border: none;
    border-radius: 8px;

    padding: 9px 18px;

    color: #FFFFFF;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 13px;
}

#opPrimaryButton:hover {
    background-color: #1D4ED8;
}

#opPrimaryButton:disabled {
    background-color: #B9CDF6;
}

#opSecondaryButton {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 10px;

    padding: 8px 14px;

    color: #3A4A63;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;
}

#opSecondaryButton:hover {
    background-color: #F3F7FC;

    border: 1px solid #D7E2F0;
}

#opSecondaryButton:disabled {
    color: #A9B4C4;
}

#opIconButton {
    background-color: transparent;

    border: none;
    border-radius: 8px;
}

#opIconButton:hover {
    background-color: #EEF3FA;
}

#opCard {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 14px;
}

#opFieldLabel {
    background: transparent;

    color: #53637A;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;
}

#opHint {
    background: transparent;

    color: #6B7A90;

    font-size: 12px;
}

#opWarning {
    background-color: #FFF4EC;

    border: 1px solid #FBD5BB;
    border-radius: 10px;

    padding: 9px 12px;

    color: #B8461B;

    font-size: 12px;
}

#opInput {
    background-color: #F8FAFD;

    border: 1px solid #E5EAF1;
    border-radius: 10px;

    padding: 0 12px;

    color: #172033;

    font-size: 13px;
}

#opInput:focus {
    background-color: #FFFFFF;

    border: 1px solid #93C5FD;
}

#opInput:disabled {
    color: #A9B4C4;
}

#opFileRow {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 12px;
}

#opFileName {
    background: transparent;

    color: #172033;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 13px;
}

#opFileDetail {
    background: transparent;

    color: #9AA6B7;

    font-size: 11px;
}

#convertKindBadge {
    border-radius: 16px;
}

#convertKindBadge[accentColor="sky"] {
    background-color: #E3F4FD;
}

#convertKindBadge[accentColor="red"] {
    background-color: #FDECEB;
}

#convertKindBadge[accentColor="blue"] {
    background-color: #E9F0FE;
}

#convertKindBadge[accentColor="orange"] {
    background-color: #FFF0E6;
}

#convertKindIcon {
    background: transparent;
}

#convertKindText {
    background: transparent;

    color: #172033;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 12px;
}

#busyOverlay {
    background-color: rgba(255, 255, 255, 190);
}

#busyOverlayLabel {
    background: transparent;

    color: #1859C9;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 14px;
}

#editSourceChip {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 12px;
}

#editSourceName {
    background: transparent;

    color: #172033;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 13px;
}

#editToolButton {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 10px;

    padding: 8px 7px;

    color: #3A4A63;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;
}

#editToolButton:hover {
    background-color: #F3F7FC;

    border: 1px solid #D7E2F0;
}

#editToolButton[danger="true"] {
    color: #C0392B;
}

#editToolButton[danger="true"]:hover {
    background-color: #FDECEB;

    border: 1px solid #F6C8C4;
}

#editToolButton:disabled {
    background-color: #F8FAFD;

    color: #A9B4C4;
}

#editThumb {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 12px;
}

#editThumb:hover {
    border: 1px solid #C9D8EE;
}

#editThumb[selected="true"] {
    background-color: #F5F9FF;

    border: 2px solid #2563EB;
}

#editThumbImage {
    background-color: #F2F5FA;

    border-radius: 4px;
}

#editThumbNumber {
    background: transparent;

    color: #53637A;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 11px;
}

#pickerList {
    background: transparent;

    border: none;

    outline: none;
}

#pickerList::item {
    background-color: #F8FAFD;

    border: 1px solid #E5EAF1;
    border-radius: 10px;
}

#pickerList::item:hover {
    background-color: #F3F7FC;
}

#pickerList::item:selected {
    background-color: #EBF3FF;

    border: 1px solid #93C5FD;
}

#pickerRow {
    background: transparent;
}

#pickerEmptyText {
    background: transparent;

    color: #6B7A90;

    font-size: 13px;
}

#pickerComputerButton {
    background-color: #FFFFFF;

    border: 1px dashed #BFD7FE;
    border-radius: 10px;

    padding: 10px 16px;

    color: #1859C9;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 13px;
}

#pickerComputerButton:hover {
    background-color: #EBF3FF;
}

