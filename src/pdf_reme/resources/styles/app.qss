/* =========================================================
   ARAÇ SAYFALARI: ilerleme, segment, kaydırmalı sayfa görünümü
   ========================================================= */

#busyProgress {
    background-color: #DCE6F5;

    border: none;
    border-radius: 4px;

    min-height: 8px;
    max-height: 8px;
}

#busyProgress::chunk {
    background-color: #2563EB;

    border-radius: 4px;
}

#busyProgressLabel {
    background: transparent;

    color: #1859C9;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 15px;
}

#busyOverlayDetail {
    background: transparent;

    color: #6B7A90;

    font-size: 12px;
}

#opSegment {
    background-color: #FFFFFF;

    border: 1px solid #D7E2F0;
    border-radius: 0px;

    padding: 8px 16px;

    color: #3A4A63;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;
}

#opSegment[segmentPosition="first"] {
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

#opSegment[segmentPosition="middle"] {
    border-left: none;
}

#opSegment[segmentPosition="last"] {
    border-left: none;

    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

#opSegment:hover {
    background-color: #F3F7FC;
}

#opSegment:checked {
    background-color: #E8F0FE;

    border-color: #93B4F5;

    color: #1D4ED8;
}

#editStripScroll,
#editStripScroll QWidget#qt_scrollarea_viewport,
#editStripContent {
    background-color: transparent;

    border: none;
}

#pageScrollArea {
    background-color: #EAEFF7;

    border: 1px solid #E0E7F2;
    border-radius: 14px;
}

#pageScrollArea QWidget#qt_scrollarea_viewport,
#pageScrollContent {
    background-color: transparent;
}

#pageViewFrame {
    background-color: #FFFFFF;

    border: 1px solid #CBD5E4;
}

#pageViewFrame[selected="true"] {
    border: 3px solid #2563EB;
}

#pageViewFrame[flash="true"] {
    border: 3px solid #F59E0B;
}

#pageViewNumber {
    background: transparent;

    color: #6B7A90;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 11px;
}

#editPageIndicator {
    background: transparent;

    color: #3A4A63;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 13px;
}

#appRoot[theme="dark"] #busyProgress {
    background-color: #243352;
}

#appRoot[theme="dark"] #busyProgress::chunk {
    background-color: #3B82F6;
}

#appRoot[theme="dark"] #busyProgressLabel {
    color: #93C5FD;
}

#appRoot[theme="dark"] #busyOverlayDetail {
    color: #94A0B4;
}

#appRoot[theme="dark"] #opSegment {
    background-color: #171D2C;

    border: 1px solid #2C374E;

    color: #B4BECC;
}

#appRoot[theme="dark"] #opSegment[segmentPosition="middle"],
#appRoot[theme="dark"] #opSegment[segmentPosition="last"] {
    border-left: none;
}

#appRoot[theme="dark"] #opSegment:hover {
    background-color: #1C2A42;
}

#appRoot[theme="dark"] #opSegment:checked {
    background-color: #17233A;

    border-color: #3B82F6;

    color: #93C5FD;
}

#appRoot[theme="dark"] #pageScrollArea {
    background-color: #10151F;

    border: 1px solid #232B3D;
}

#appRoot[theme="dark"] #pageViewFrame {
    border: 1px solid #2C374E;
}

#appRoot[theme="dark"] #pageViewFrame[selected="true"] {
    border: 3px solid #3B82F6;
}

#appRoot[theme="dark"] #pageViewFrame[flash="true"] {
    border: 3px solid #FBBF24;
}

#appRoot[theme="dark"] #pageViewNumber {
    color: #9AA6B7;
}

#appRoot[theme="dark"] #editPageIndicator {
    color: #D5DCE8;
}
