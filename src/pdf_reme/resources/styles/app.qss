/* =========================================================
   PDF-REME
   GLOBAL THEME

   Bu dosya hem açık hem koyu temayı tek kaynaktan yönetir.
   Koyu tema kuralları, #appRoot üzerindeki dinamik "theme"
   property'sine göre [theme="dark"] öznitelik seçicileriyle
   override edilir (main_window.py bu property'yi set edip
   app.setStyleSheet(app.styleSheet()) ile repolish tetikler).

   Renk tokenları presentation/theme.py THEMES sözlüğüyle elle
   senkron tutulur (QSS Python sabitlerini okuyamaz).

   "Plus Jakarta Sans" ailesi Regular/Bold için klasik stil
   linkiyle gelir (font-weight: 700 yeterli); Medium/SemiBold
   ise OpenType'ın 4 stilli aile sınırı yüzünden ayrı aile
   adlarıyla kayıtlıdır, bu yüzden ilgili kurallarda doğrudan
   "Plus Jakarta Sans Medium" / "Plus Jakarta Sans SemiBold"
   aile adı kullanılır.
   ========================================================= */

QWidget {
    font-family: "Plus Jakarta Sans", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #172033;
}

QMainWindow {
    background-color: #F6F8FC;
}

#appRoot {
    background-color: #F6F8FC;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

#sidebar {
    background-color: #FFFFFF;

    border: none;
    border-right: 1px solid #E5EAF1;
}


/* =========================================================
   BRAND
   ========================================================= */

#sidebarBrand {
    background-color: transparent;
}

#sidebarLogo {
    background-color: transparent;
}

#sidebarBrandTitle {
    background-color: transparent;

    color: #102447;

    font-family: "Plus Jakarta Sans";
    font-size: 17px;
    font-weight: 700;
}


/* =========================================================
   SIDEBAR SCROLL AREA
   ========================================================= */

#sidebarScrollArea {
    background-color: transparent;

    border: none;
}

#sidebarScrollArea > QWidget {
    background-color: transparent;
}

#sidebarScrollArea QWidget#qt_scrollarea_viewport {
    background-color: transparent;
}

#sidebarNavigation {
    background-color: transparent;
}


/* =========================================================
   SIDEBAR SECTION TITLES
   ========================================================= */

#sidebarSectionTitle {
    color: #9AA6B7;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 9px;

    padding-left: 11px;
    padding-top: 7px;
    padding-bottom: 4px;
}


/* =========================================================
   SIDEBAR NAVIGATION BUTTON
   ========================================================= */

QPushButton[navButton="true"] {
    min-height: 40px;

    background-color: transparent;

    border: none;
    border-left: 3px solid transparent;

    border-radius: 9px;

    padding-left: 13px;
    padding-right: 10px;

    color: #53637A;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;

    text-align: left;
}

QPushButton[navButton="true"]:hover {
    background-color: #F3F7FC;

    color: #1D5FD1;
}

QPushButton[navButton="true"]:checked {
    background-color: #EBF3FF;

    border-left: 3px solid #2563EB;

    color: #1859C9;

    font-family: "Plus Jakarta Sans SemiBold";
}

QPushButton[navButton="true"]:pressed {
    background-color: #DFEBFC;
}


/* =========================================================
   SIDEBAR FOOTER
   ========================================================= */

#sidebarFooter {
    color: #A3ADBC;

    font-size: 9px;

    padding-left: 5px;
}


/* =========================================================
   SIDEBAR PINNED FOOTER (SETTINGS / LANGUAGE / THEME)
   ========================================================= */

#sidebarDivider {
    background-color: #E5EAF1;

    border: none;
    max-height: 1px;
}

#sidebarFlagButton {
    background-color: transparent;

    border: 1px solid transparent;
    border-radius: 8px;
}

#sidebarFlagButton:hover {
    background-color: #F3F7FC;

    border: 1px solid #E5EAF1;
}

#sidebarFlagButton:checked {
    background-color: #EBF3FF;

    border: 1px solid #BFD7FE;
}

#sidebarThemeButton {
    background-color: transparent;

    border: 1px solid transparent;
    border-radius: 17px;
}

#sidebarThemeButton:hover {
    background-color: #F3F7FC;

    border: 1px solid #E5EAF1;
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

#contentArea {
    background-color: #F7F9FC;

    border: none;
}

#pageStack {
    background-color: #F7F9FC;

    border: none;
}

#placeholderPage {
    background-color: #F7F9FC;
}


/* =========================================================
   PAGE TYPOGRAPHY
   ========================================================= */

#pageTitle {
    color: #102447;

    font-family: "Plus Jakarta Sans";
    font-size: 28px;
    font-weight: 700;
}

#pageDescription {
    color: #64748B;

    font-size: 14px;
}


/* =========================================================
   DASHBOARD
   ========================================================= */

#dashboardScrollArea {
    background-color: transparent;

    border: none;
}

#dashboardScrollArea QWidget#qt_scrollarea_viewport {
    background-color: transparent;
}

#dashboardContent {
    background-color: transparent;
}

#dashboardTitle {
    color: #102447;

    font-family: "Plus Jakarta Sans";
    font-size: 26px;
    font-weight: 700;
}

#dashboardSubtitle {
    color: #64748B;

    font-size: 13px;
}

#dashboardSectionTitle {
    color: #172033;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 15px;
}


/* ---------------------------------------------------------
   QUICK ACTION CARDS
   --------------------------------------------------------- */

#dashboardActionCard {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 16px;
}

#dashboardActionCard:hover {
    border: 1px solid #D7E2F0;
}

#dashboardActionIconContainer {
    border-radius: 12px;
}

#dashboardActionIconContainer[accentColor="red"] {
    background-color: #FDECEB;
}

#dashboardActionIconContainer[accentColor="blue"] {
    background-color: #E9F0FE;
}

#dashboardActionIconContainer[accentColor="purple"] {
    background-color: #F2EAFC;
}

#dashboardActionIconContainer[accentColor="green"] {
    background-color: #E4F9F0;
}

#dashboardActionIconContainer[accentColor="teal"] {
    background-color: #E1F5F2;
}

#dashboardActionTitle {
    color: #172033;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 15px;
}

#dashboardActionDescription {
    color: #7A8699;

    font-size: 12px;
}

/* ---------------------------------------------------------
   LOWER PANELS
   --------------------------------------------------------- */

#dashboardPanel {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 16px;
}

#dashboardPanelTitle {
    color: #172033;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 14px;
}

#dashboardTextButton {
    background-color: transparent;

    border: none;

    color: #2563EB;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 11px;
}

#dashboardTextButton:hover {
    color: #1746A2;

    text-decoration: underline;
}

#dashboardToolButton {
    background-color: transparent;

    border: none;
    border-radius: 9px;

    padding: 9px 10px;

    color: #3E4C61;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;

    text-align: left;
}

#dashboardToolButton:hover {
    background-color: #F3F7FC;

    color: #1D5FD1;
}

#dashboardEmptyText {
    color: #9AA6B7;

    font-size: 12px;
}

#recentDocumentRow {
    background-color: #FAFBFD;

    border: 1px solid #EEF1F6;
    border-radius: 12px;
}

#recentDocumentRow:hover {
    background-color: #F3F7FC;

    border: 1px solid #E5EAF1;
}

#recentDocumentName {
    color: #172033;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 12px;
}

#recentDocumentMeta {
    color: #9AA6B7;

    font-size: 10px;
}

#recentDocumentOpenButton {
    background-color: transparent;

    border: 1px solid #E5EAF1;
    border-radius: 8px;

    padding: 4px 12px;

    color: #2563EB;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 11px;
}

#recentDocumentOpenButton:hover {
    background-color: #EBF3FF;

    border: 1px solid #BFD7FE;
}

#libraryUploadButton {
    background-color: #2563EB;

    border: none;
    border-radius: 8px;

    padding: 8px 16px;

    color: #FFFFFF;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 13px;
}

#libraryUploadButton:hover {
    background-color: #1D4ED8;
}

/* ---------------------------------------------------------
   DOCUMENT CARD (Kütüphane / Favoriler / Son Kullanılanlar / Çöp Kutusu)
   --------------------------------------------------------- */

#documentCard {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 14px;
}

#documentCardTitle {
    color: #172033;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 13px;
}

#documentCardMeta {
    color: #9AA6B7;

    font-size: 11px;
}

#documentCardIconButton {
    background-color: transparent;

    border: 1px solid #E5EAF1;
    border-radius: 8px;
}

#documentCardIconButton:hover {
    background-color: #F3F7FC;

    border: 1px solid #D7E2F0;
}

#documentCardIconButton[danger="true"]:hover {
    background-color: #FDECEB;

    border: 1px solid #F6C6C2;
}


/* ---------------------------------------------------------
   LIST TOOLBAR (Arama / Sıralama)
   --------------------------------------------------------- */

#pageSearchInput {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 10px;

    padding: 8px 12px 8px 34px;

    color: #172033;

    font-size: 13px;
}

#pageSearchInput:focus {
    border: 1px solid #93C5FD;
}

/* ---------------------------------------------------------
   TYPE FILTER CHIPS
   --------------------------------------------------------- */

#typeFilterChip {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 16px;

    padding: 6px 14px;

    color: #53637A;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;
}

#typeFilterChip:hover {
    background-color: #F3F7FC;

    border: 1px solid #D7E2F0;
}

#typeFilterChip:checked {
    border: 1px solid #BFD7FE;

    color: #1859C9;

    font-family: "Plus Jakarta Sans SemiBold";
}

#typeFilterChip[accentColor="neutral"]:checked {
    background-color: #EBF3FF;
}

#typeFilterChip[accentColor="red"]:checked {
    background-color: #FDECEB;
}

#typeFilterChip[accentColor="blue"]:checked {
    background-color: #E9F0FE;
}

#typeFilterChip[accentColor="purple"]:checked {
    background-color: #F2EAFC;
}

#typeFilterChip[accentColor="green"]:checked {
    background-color: #E4F9F0;
}

#typeFilterChip[accentColor="teal"]:checked {
    background-color: #E1F5F2;
}


#pageSortCombo {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 10px;
}

#pageSortCombo:hover {
    background-color: #F8FAFD;

    border: 1px solid #D7E2F0;
}

#pageSortComboText {
    background: transparent;

    color: #172033;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;
}

#dropdownPanel {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 12px;
}

#dropdownItem {
    background-color: transparent;

    border: none;
    border-radius: 8px;

    padding: 8px 12px;

    color: #3A4A63;

    text-align: left;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;
}

#dropdownItem:hover {
    background-color: #F3F7FC;
}

#dropdownItem[selected="true"] {
    background-color: #EBF3FF;

    color: #1859C9;

    font-family: "Plus Jakarta Sans SemiBold";
}

#selectionToggleButton {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 10px;

    padding: 0 14px;

    color: #3A4A63;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;
}

#selectionToggleButton:hover {
    background-color: #F3F7FC;

    border: 1px solid #D7E2F0;
}

#selectionToggleButton:checked {
    background-color: #EBF3FF;

    border: 1px solid #BFD7FE;

    color: #1859C9;
}

#selectionBar {
    background-color: #F5F9FF;

    border: 1px solid #D7E6FC;
    border-radius: 12px;
}

#selectionBarLabelButton {
    background: transparent;

    border: none;

    padding: 4px 2px;

    color: #172033;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 12px;
}

#selectionBarCount {
    background: transparent;

    color: #6B7A90;

    font-size: 12px;
}

#selectionBarActionButton {
    background-color: #FFFFFF;

    border: 1px solid #D7E2F0;
    border-radius: 8px;

    padding: 6px 12px;

    color: #1859C9;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;
}

#selectionBarActionButton:hover {
    background-color: #EBF3FF;
}

#selectionBarActionButton[danger="true"] {
    border: 1px solid #F6C6C2;

    color: #D33A2E;
}

#selectionBarActionButton[danger="true"]:hover {
    background-color: #FDECEB;
}

#selectionBarActionButton:disabled {
    background-color: #F3F5F9;

    border: 1px solid #E5EAF1;

    color: #B4BECC;
}

#documentCard[selected="true"] {
    background-color: #F5F9FF;

    border: 1px solid #93C5FD;
}

#dropOverlay {
    background-color: rgba(235, 243, 255, 235);

    border: 2px dashed #60A5FA;
    border-radius: 16px;
}

#dropOverlayTitle {
    background: transparent;

    color: #1859C9;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 18px;
}

#dropOverlayBody {
    background: transparent;

    color: #53637A;

    font-size: 13px;
}

/* ---------------------------------------------------------
   APP DIALOG (PDF-REME onay / bilgi pencereleri)
   --------------------------------------------------------- */

#appDialogCard {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 18px;
}

#appDialogIconBubble {
    border-radius: 26px;
}

#appDialogIconBubble[accentColor="red"] {
    background-color: #FDECEB;
}

#appDialogIconBubble[accentColor="blue"] {
    background-color: #E9F0FE;
}

#appDialogIconBubble[accentColor="green"] {
    background-color: #E4F9F0;
}

#appDialogIconBubble[accentColor="purple"] {
    background-color: #F2EAFC;
}

#appDialogTitle {
    background: transparent;

    color: #172033;

    font-family: "Plus Jakarta Sans";
    font-weight: 700;
    font-size: 17px;
}

#appDialogBody {
    background: transparent;

    color: #53637A;

    font-size: 13px;
}

#appDialogItemsScroll {
    background: transparent;

    border: none;
}

#appDialogItemsContainer {
    background: transparent;
}

#appDialogItemRow {
    background-color: #F8FAFD;

    border: 1px solid #E5EAF1;
    border-radius: 10px;
}

#appDialogItemName {
    background: transparent;

    color: #172033;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;
}

#appDialogItemDetail {
    background: transparent;

    color: #9AA6B7;

    font-size: 11px;
}

#appDialogCancelButton {
    background-color: #FFFFFF;

    border: 1px solid #E5EAF1;
    border-radius: 10px;

    padding: 9px 20px;

    color: #3A4A63;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 13px;
}

#appDialogCancelButton:hover {
    background-color: #F3F7FC;

    border: 1px solid #D7E2F0;
}

#appDialogConfirmButton {
    border: none;
    border-radius: 10px;

    padding: 9px 22px;

    color: #FFFFFF;

    font-family: "Plus Jakarta Sans SemiBold";
    font-size: 13px;
}

#appDialogConfirmButton[variant="primary"],
#appDialogConfirmButton[variant="info"] {
    background-color: #2563EB;
}

#appDialogConfirmButton[variant="primary"]:hover,
#appDialogConfirmButton[variant="info"]:hover {
    background-color: #1D4ED8;
}

#appDialogConfirmButton[variant="success"] {
    background-color: #16A34A;
}

#appDialogConfirmButton[variant="success"]:hover {
    background-color: #15803D;
}

#appDialogConfirmButton[variant="danger"] {
    background-color: #DC3B30;
}

#appDialogConfirmButton[variant="danger"]:hover {
    background-color: #C22D23;
}

#dashboardActionIconContainer[accentColor="sky"] {
    background-color: #E0F4FE;
}

#dashboardActionIconContainer[accentColor="orange"] {
    background-color: #FEEDE7;
}

#typeFilterChip[accentColor="sky"]:checked {
    background-color: #E0F4FE;
}

#typeFilterChip[accentColor="orange"]:checked {
    background-color: #FEEDE7;
}


/* ---------------------------------------------------------
   MESSAGE BOX
   --------------------------------------------------------- */

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #172033;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 13px;
}

QMessageBox QPushButton {
    background-color: transparent;

    border: 1px solid #E5EAF1;
    border-radius: 8px;

    padding: 6px 18px;

    color: #172033;

    font-family: "Plus Jakarta Sans Medium";
    font-size: 12px;

    min-width: 70px;
}

QMessageBox QPushButton:hover {
    background-color: #F1F5FB;
}

QMessageBox QPushButton:default {
    background-color: #2563EB;

    border: none;

    color: #FFFFFF;

    font-family: "Plus Jakarta Sans SemiBold";
}

QMessageBox QPushButton:default:hover {
    background-color: #1D4ED8;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

QScrollBar:vertical {
    width: 6px;

    background-color: transparent;

    margin: 2px 0 2px 0;
}

QScrollBar::handle:vertical {
    min-height: 28px;

    background-color: #D6DDE8;

    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #BFC9D8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    background-color: #172033;

    color: #FFFFFF;

    border: none;

    padding: 6px 8px;
}


/* =========================================================
   =========================================================
   DARK THEME OVERRIDES
   =========================================================
   ========================================================= */

#appRoot[theme="dark"] {
    background-color: #0F1420;
}

#appRoot[theme="dark"] QWidget {
    color: #E6EAF2;
}

#appRoot[theme="dark"] #sidebar {
    background-color: #12141F;

    border-right: 1px solid #232B3D;
}

#appRoot[theme="dark"] #sidebarBrandTitle {
    color: #F1F4FA;
}

#appRoot[theme="dark"] #sidebarSectionTitle {
    color: #94A0B4;
}

#appRoot[theme="dark"] QPushButton[navButton="true"] {
    color: #A3ADC0;
}

#appRoot[theme="dark"] QPushButton[navButton="true"]:hover {
    background-color: #1A2030;

    color: #7FADFB;
}

#appRoot[theme="dark"] QPushButton[navButton="true"]:checked {
    background-color: #1C2A42;

    border-left: 3px solid #3B82F6;

    color: #9CC0FC;
}

#appRoot[theme="dark"] QPushButton[navButton="true"]:pressed {
    background-color: #202B42;
}

#appRoot[theme="dark"] #sidebarFooter {
    color: #7F8AA0;
}

#appRoot[theme="dark"] #sidebarDivider {
    background-color: #232B3D;
}

#appRoot[theme="dark"] #sidebarFlagButton:hover {
    background-color: #1A2030;

    border: 1px solid #232B3D;
}

#appRoot[theme="dark"] #sidebarFlagButton:checked {
    background-color: #1C2A42;

    border: 1px solid #2E4468;
}

#appRoot[theme="dark"] #sidebarThemeButton:hover {
    background-color: #1A2030;

    border: 1px solid #232B3D;
}

#appRoot[theme="dark"] #contentArea {
    background-color: #10141F;
}

#appRoot[theme="dark"] #pageStack {
    background-color: #10141F;
}

#appRoot[theme="dark"] #placeholderPage {
    background-color: #10141F;
}

#appRoot[theme="dark"] #pageTitle {
    color: #F1F4FA;
}

#appRoot[theme="dark"] #pageDescription {
    color: #A3ADC0;
}

#appRoot[theme="dark"] #dashboardTitle {
    color: #F1F4FA;
}

#appRoot[theme="dark"] #dashboardSubtitle {
    color: #A3ADC0;
}

#appRoot[theme="dark"] #dashboardSectionTitle {
    color: #E6EAF2;
}

#appRoot[theme="dark"] #dashboardActionCard {
    background-color: #171D2C;

    border: 1px solid #232B3D;
}

#appRoot[theme="dark"] #dashboardActionCard:hover {
    border: 1px solid #2C374E;
}

#appRoot[theme="dark"] #dashboardActionIconContainer[accentColor="red"] {
    background-color: #3B2226;
}

#appRoot[theme="dark"] #dashboardActionIconContainer[accentColor="blue"] {
    background-color: #1D2A40;
}

#appRoot[theme="dark"] #dashboardActionIconContainer[accentColor="purple"] {
    background-color: #2B2142;
}

#appRoot[theme="dark"] #dashboardActionIconContainer[accentColor="green"] {
    background-color: #163A2A;
}

#appRoot[theme="dark"] #dashboardActionIconContainer[accentColor="teal"] {
    background-color: #123B38;
}

#appRoot[theme="dark"] #dashboardActionTitle {
    color: #E6EAF2;
}

#appRoot[theme="dark"] #dashboardActionDescription {
    color: #A3ADC0;
}

#appRoot[theme="dark"] #dashboardPanel {
    background-color: #171D2C;

    border: 1px solid #232B3D;
}

#appRoot[theme="dark"] #dashboardPanelTitle {
    color: #E6EAF2;
}

#appRoot[theme="dark"] #dashboardTextButton {
    color: #3B82F6;
}

#appRoot[theme="dark"] #dashboardTextButton:hover {
    color: #7FADFB;
}

#appRoot[theme="dark"] #dashboardToolButton {
    color: #AEB8CB;
}

#appRoot[theme="dark"] #dashboardToolButton:hover {
    background-color: #1A2030;

    color: #7FADFB;
}

#appRoot[theme="dark"] #dashboardEmptyText {
    color: #94A0B4;
}

#appRoot[theme="dark"] #recentDocumentRow {
    background-color: #171B29;

    border: 1px solid #202737;
}

#appRoot[theme="dark"] #recentDocumentRow:hover {
    background-color: #1A2030;

    border: 1px solid #2C374E;
}

#appRoot[theme="dark"] #recentDocumentName {
    color: #E6EAF2;
}

#appRoot[theme="dark"] #recentDocumentMeta {
    color: #94A0B4;
}

#appRoot[theme="dark"] #recentDocumentOpenButton {
