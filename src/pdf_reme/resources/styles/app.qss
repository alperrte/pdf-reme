    border: 1px solid #2C374E;
}

#appRoot[theme="dark"] #pageSortComboText {
    color: #E6EAF2;
}

#appRoot[theme="dark"] #dropdownPanel {
    background-color: #171D2C;

    border: 1px solid #2C374E;
}

#appRoot[theme="dark"] #dropdownItem {
